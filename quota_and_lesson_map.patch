+.tl-quota-over { border-color: var(--learning); box-shadow: 0 0 0 3px var(--learning-bg), var(--shadow-sm); }
+.tl-quota-over .tl-count-num { color: var(--learning); }
+
+/* Lesson map: one dot per lesson, green when done, click to toggle. */
+.tl-map-hint { font-family: var(--font-ui); font-size: var(--fs-2xs); color: var(--ink-soft); margin: 0 0 var(--space-4); }
+.tl-map { display: flex; flex-direction: column; gap: var(--space-5); }
+.tl-map-level-title {
+  font-family: var(--font-jp);
+  font-size: 1rem;
+  margin: 0 0 var(--space-3);
+  padding-bottom: var(--space-1);
+  border-bottom: 1px solid var(--line);
+  color: var(--ink);
+}
+.tl-track { margin-bottom: var(--space-4); }
+.tl-track:last-child { margin-bottom: 0; }
+.tl-track-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-2); }
+.tl-track-name { font-family: var(--font-ui); font-size: var(--fs-xs); color: var(--ink); font-weight: 600; }
+.tl-track-count { font-family: var(--font-ui); font-size: var(--fs-2xs); color: var(--ink-soft); }
+.tl-dots { display: flex; flex-wrap: wrap; gap: var(--space-2); }
+.tl-dot {
+  width: 34px;
+  height: 34px;
+  border-radius: 50%;
+  border: 1px solid var(--line);
+  background: var(--paper);
+  color: var(--ink-soft);
+  font-family: var(--font-ui);
+  font-size: var(--fs-2xs);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.12s ease, background 0.15s ease, color 0.15s ease;
+}
+.tl-dot:hover { transform: translateY(-2px); border-color: var(--indigo); }
+.tl-dot-done { background: var(--mastered); border-color: var(--mastered); color: #fff; font-weight: 700; }
+
+@media (max-width: 560px) {
+  .tl-dot { width: 30px; height: 30px; }
+}
