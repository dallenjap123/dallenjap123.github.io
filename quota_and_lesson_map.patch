+
+/* Quota cell: the day's target at a glance. Turns green once both tracks are
+   met and amber-ish once you're past it, so "am I done for today" is legible
+   without reading any numbers. */
+.tl-quota-split { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center; margin-top: var(--space-1); }
+.tl-qs {
+  font-family: var(--font-ui);
+  font-size: var(--fs-2xs);
+  padding: 1px var(--space-2);
+  border-radius: var(--radius-pill);
+  background: var(--paper-deep);
+  color: var(--ink);
+}
+.tl-qs-ok { background: var(--mastered); color: #fff; }
+.tl-quota-met { border-color: var(--mastered); box-shadow: 0 0 0 3px var(--mastered-bg), var(--shadow-sm); }
